{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from $defs.processSpec of the superproject catalog schema (packages/schema/v1/object.schema.json): process_schema_from_catalog().",
  "$ref": "#/$defs/processSpec",
  "$defs": {
    "assignChain": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/assignee"
      },
      "description": "Кандидаты по порядку: берётся первый разрешимый"
    },
    "assignee": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "principal"
          ]
        },
        {
          "required": [
            "role"
          ]
        },
        {
          "required": [
            "agent"
          ]
        },
        {
          "required": [
            "expr"
          ]
        }
      ],
      "properties": {
        "principal": {
          "$ref": "#/$defs/envOrUuid"
        },
        "role": {
          "$ref": "#/$defs/slug"
        },
        "agent": {
          "$ref": "#/$defs/slug"
        },
        "expr": {
          "$ref": "#/$defs/cel",
          "description": "CEL → id principal, agent:<key> или role:<slug>"
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/processStep"
      },
      "description": "Последовательность шагов (блок do)"
    },
    "cel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Выражение CEL в профиле taimen/1 (CP-ADR-0075): переменные data, event, step, task, instance; функции cal.*; без текущего времени. Типы и лимит стоимости проверяет ядро"
    },
    "celMap": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/cel"
      },
      "description": "Путь в данных экземпляра → выражение CEL"
    },
    "decisionTable": {
      "type": "object",
      "required": [
        "id",
        "hitPolicy",
        "inputs",
        "outputs",
        "rules"
      ],
      "additionalProperties": false,
      "description": "Таблица решений (DMN по смыслу). Ячейка условия: '-' (любое), литерал, список 'a,b', диапазон '[a..b)'",
      "properties": {
        "id": {
          "$ref": "#/$defs/processElementId"
        },
        "displayName": {
          "$ref": "#/$defs/displayName"
        },
        "hitPolicy": {
          "enum": [
            "first",
            "unique",
            "collect"
          ]
        },
        "governedBy": {
          "$ref": "#/$defs/governedBy"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "id",
              "expr"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/processElementId"
              },
              "expr": {
                "$ref": "#/$defs/cel"
              },
              "type": {
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "date",
                  "timestamp"
                ]
              }
            }
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/processElementId"
              },
              "type": {
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "date",
                  "duration",
                  "object",
                  "array"
                ]
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "when",
              "then"
            ],
            "additionalProperties": false,
            "properties": {
              "when": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              },
              "then": {
                "type": "object"
              },
              "note": {
                "type": "string",
                "maxLength": 500
              },
              "governedBy": {
                "$ref": "#/$defs/governedBy"
              }
            }
          }
        }
      }
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "duration": {
      "type": "string",
      "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$",
      "description": "Длительность ISO 8601, например P3D, PT4H"
    },
    "durationOrCel": {
      "description": "Длительность ISO 8601 или выражение CEL, дающее момент времени (timestamp) или длительность",
      "oneOf": [
        {
          "$ref": "#/$defs/duration"
        },
        {
          "type": "object",
          "required": [
            "at"
          ],
          "additionalProperties": false,
          "properties": {
            "at": {
              "$ref": "#/$defs/cel"
            }
          }
        }
      ]
    },
    "envOrUuid": {
      "type": "string",
      "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "UUID или ${ПЕРЕМЕННАЯ} установки (топология окружения в пакет не пишется)"
    },
    "escalation": {
      "type": "object",
      "required": [
        "after",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "after": {
          "oneOf": [
            {
              "const": "due"
            },
            {
              "$ref": "#/$defs/durationOrCel"
            }
          ],
          "description": "due — в момент срока; длительность — после срока"
        },
        "action": {
          "enum": [
            "remind",
            "reassign",
            "notify",
            "raise"
          ]
        },
        "to": {
          "$ref": "#/$defs/assignChain"
        },
        "error": {
          "$ref": "#/$defs/processError"
        }
      }
    },
    "governedBy": {
      "type": "array",
      "maxItems": 20,
      "description": "Регламенты базы знаний, которым подчиняется элемент (TAI-ADR-0054 Р17): естественный ключ документа памяти и, при необходимости, пункт",
      "items": {
        "type": "object",
        "required": [
          "document"
        ],
        "additionalProperties": false,
        "properties": {
          "document": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "section": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "jsonSchema": {
      "type": "object",
      "description": "JSON Schema документа (draft 2020-12). Удалённые $ref ядро отвергает."
    },
    "memoryAnchor": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "case"
          ]
        },
        {
          "required": [
            "key",
            "kind"
          ]
        }
      ],
      "description": "Якорь обхода графа: узел дела экземпляра или сущность по естественному ключу (CEL от данных)",
      "properties": {
        "case": {
          "const": true
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "key": {
          "$ref": "#/$defs/cel"
        },
        "via": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "memoryProjection": {
      "type": "object",
      "required": [
        "case"
      ],
      "additionalProperties": false,
      "description": "Проекция дела в граф памяти (TAI-ADR-0054 Р15): доставляется событиями, в граф идут только объявленные поля",
      "properties": {
        "case": {
          "type": "object",
          "required": [
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "default": "case"
            },
            "key": {
              "$ref": "#/$defs/cel"
            },
            "title": {
              "$ref": "#/$defs/cel"
            }
          }
        },
        "facts": {
          "$ref": "#/$defs/celMap",
          "description": "Имя факта дела → значение; изменение закрывает прежний факт сроком действия"
        },
        "entities": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "key",
              "rel"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "key": {
                "$ref": "#/$defs/cel"
              },
              "name": {
                "$ref": "#/$defs/cel"
              },
              "rel": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "when": {
                "$ref": "#/$defs/cel"
              },
              "many": {
                "type": "boolean",
                "description": "key даёт список: по сущности на элемент"
              }
            }
          }
        },
        "documents": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifacts": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/typeKey"
              }
            }
          }
        }
      }
    },
    "memoryTraverse": {
      "type": "array",
      "maxItems": 10,
      "description": "Шаги обхода от якорей — та же форма, что traverse в contextSchema (CP-ADR-0064)",
      "items": {
        "type": "object",
        "required": [
          "relation"
        ],
        "additionalProperties": false,
        "properties": {
          "relation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "direction": {
            "enum": [
              "in",
              "out",
              "both"
            ]
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "from": {
            "enum": [
              "anchors",
              "previous"
            ]
          }
        }
      }
    },
    "memoryWhere": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "description": "Фильтры по атрибутам узлов (TAI-ADR-0056 Р7, MEM-ADR-020): применяются к узлам результата и к якорям-кандидатам смыслового добора; условия соединяются через И",
      "items": {
        "type": "object",
        "required": [
          "attr",
          "op"
        ],
        "additionalProperties": false,
        "properties": {
          "attr": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "description": "Имя атрибута узла (плоское, как в MEM-ADR-020), например okpd2 или validUntil; атрибут-список выполняет условие, если его выполняет хоть один элемент"
          },
          "op": {
            "enum": [
              "eq",
              "in",
              "prefix",
              "lte",
              "gte",
              "exists"
            ],
            "description": "prefix сравнивает коды по сегментам через точку: 62.01 совпадает с 62.01.11, но не с 62.011; lte/gte — даты RFC 3339 или числа"
          },
          "value": {
            "description": "CEL-выражение от данных экземпляра (строковый литерал — в кавычках CEL: \"'62.01'\"); для in — CEL-список или список выражений; для exists — true или false",
            "anyOf": [
              {
                "$ref": "#/$defs/cel"
              },
              {
                "type": [
                  "number",
                  "boolean"
                ]
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "items": {
                  "$ref": "#/$defs/cel"
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "op": {
                  "not": {
                    "const": "exists"
                  }
                }
              }
            },
            "then": {
              "required": [
                "value"
              ]
            }
          }
        ]
      }
    },
    "processElementId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "description": "Стабильный id элемента процесса: на него ссылаются раскладка схемы, карты миграции, журнал и граф памяти. Переименование — только картой migrations"
    },
    "processError": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "Ошибка в форме RFC 7807",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "detail": {
          "$ref": "#/$defs/cel"
        }
      }
    },
    "processForm": {
      "type": "object",
      "required": [
        "schema"
      ],
      "additionalProperties": false,
      "description": "Форма шага: JSON Schema данных и uischema JSON Forms представления",
      "properties": {
        "schema": {
          "$ref": "#/$defs/jsonSchema"
        },
        "uischema": {
          "type": "object"
        }
      }
    },
    "processSpec": {
      "type": "object",
      "description": "Процесс (TAI-ADR-0054, CP-ADR-0074): кейс со стадиями и блоками исполнения, данные по схеме, выражения CEL, проекция в память. Исполняет ядро",
      "required": [
        "version",
        "displayName",
        "data",
        "start",
        "stages"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Версия определения: опубликованная версия неизменяема"
        },
        "displayName": {
          "$ref": "#/$defs/displayName"
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^\\$\\{[A-Z][A-Z0-9_]*\\}$"
        },
        "identity": {
          "type": "object",
          "required": [
            "agent"
          ],
          "additionalProperties": false,
          "description": "От чьего имени действует процесс: описание агента вида service или agent",
          "properties": {
            "agent": {
              "$ref": "#/$defs/slug"
            }
          }
        },
        "owner": {
          "$ref": "#/$defs/assignChain",
          "description": "Владелец процесса — ему адресуются задачи о процессе: расхождение с регламентом, ошибки экземпляров (TAI-ADR-0054 п.5, амендмент 2026-09-27). Не обязателен; проверка пакета предупреждает, если его нет"
        },
        "calendar": {
          "$ref": "#/$defs/typeKey",
          "description": "Календарь по умолчанию для cal.*"
        },
        "data": {
          "$ref": "#/$defs/jsonSchema",
          "description": "JSON Schema данных экземпляра; {$ref: <файл пакета>} раскрывает cp_packages"
        },
        "start": {
          "type": "object",
          "required": [
            "on",
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "on": {
              "$ref": "#/$defs/processTrigger"
            },
            "key": {
              "$ref": "#/$defs/cel",
              "description": "Ключ экземпляра: повтор события с тем же ключом — correlate, а не новый экземпляр"
            },
            "set": {
              "$ref": "#/$defs/celMap"
            }
          }
        },
        "correlate": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "on",
              "key"
            ],
            "additionalProperties": false,
            "properties": {
              "on": {
                "$ref": "#/$defs/processTrigger"
              },
              "key": {
                "$ref": "#/$defs/cel"
              },
              "set": {
                "$ref": "#/$defs/celMap"
              },
              "do": {
                "$ref": "#/$defs/blocks"
              }
            }
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/processStage"
          }
        },
        "onEvent": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "on",
              "do"
            ],
            "additionalProperties": false,
            "properties": {
              "on": {
                "$ref": "#/$defs/processTrigger"
              },
              "do": {
                "$ref": "#/$defs/blocks"
              }
            }
          }
        },
        "timers": {
          "$ref": "#/$defs/processTimers"
        },
        "decisions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/decisionTable"
          }
        },
        "governedBy": {
          "$ref": "#/$defs/governedBy"
        },
        "memory": {
          "$ref": "#/$defs/memoryProjection"
        },
        "retrospective": {
          "type": "object",
          "required": [
            "taskType",
            "assign"
          ],
          "additionalProperties": false,
          "description": "Разбор закрытого дела: агент предлагает уроки, человек подтверждает (TAI-ADR-0054 Р18)",
          "properties": {
            "skill": {
              "type": "string",
              "pattern": "^[^@\\s]+@[^@\\s]+$",
              "default": "process.retrospective@1"
            },
            "taskType": {
              "$ref": "#/$defs/typeKey"
            },
            "assign": {
              "$ref": "#/$defs/assignChain"
            },
            "appliesTo": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "description": "Виды сущностей, к которым привязываются уроки"
            },
            "when": {
              "$ref": "#/$defs/cel"
            }
          }
        },
        "migrations": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "policy"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 1
              },
              "to": {
                "type": "integer",
                "minimum": 2
              },
              "policy": {
                "enum": [
                  "pin",
                  "migrate"
                ]
              },
              "map": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/processElementId"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/processElementId"
                }
              }
            }
          }
        }
      }
    },
    "processStage": {
      "type": "object",
      "required": [
        "id",
        "steps"
      ],
      "additionalProperties": false,
      "description": "Стадия кейса (CMMN): вход и выход по сторожам, вехи, обязательная и необязательная работа",
      "properties": {
        "id": {
          "$ref": "#/$defs/processElementId"
        },
        "displayName": {
          "$ref": "#/$defs/displayName"
        },
        "entry": {
          "$ref": "#/$defs/cel",
          "description": "Сторож входа; stage.<id>.completed, milestone.<id> и data доступны в выражении"
        },
        "exit": {
          "$ref": "#/$defs/cel"
        },
        "repeatable": {
          "type": "boolean"
        },
        "governedBy": {
          "$ref": "#/$defs/governedBy"
        },
        "steps": {
          "$ref": "#/$defs/blocks"
        },
        "discretionary": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/processStep"
          },
          "description": "Работа, которую человек добавляет по решению"
        },
        "milestones": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "id",
              "when"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/processElementId"
              },
              "when": {
                "$ref": "#/$defs/cel"
              }
            }
          }
        },
        "timers": {
          "$ref": "#/$defs/processTimers"
        }
      }
    },
    "processStep": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "description": "Шаг процесса: ровно один вид (human, approve, call, decide, recall, remember, listen, wait, set, raise, compensate, fork, try, do, suspend, resume, complete) плюс общие поля",
      "oneOf": [
        {
          "required": [
            "human"
          ]
        },
        {
          "required": [
            "approve"
          ]
        },
        {
          "required": [
            "call"
          ]
        },
        {
          "required": [
            "decide"
          ]
        },
        {
          "required": [
            "recall"
          ]
        },
        {
          "required": [
            "remember"
          ]
        },
        {
          "required": [
            "listen"
          ]
        },
        {
          "required": [
            "wait"
          ]
        },
        {
          "required": [
            "set"
          ]
        },
        {
          "required": [
            "raise"
          ]
        },
        {
          "required": [
            "compensate"
          ]
        },
        {
          "required": [
            "fork"
          ]
        },
        {
          "required": [
            "try"
          ]
        },
        {
          "required": [
            "do"
          ]
        },
        {
          "required": [
            "suspend"
          ]
        },
        {
          "required": [
            "resume"
          ]
        },
        {
          "required": [
            "complete"
          ]
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/processElementId"
        },
        "displayName": {
          "$ref": "#/$defs/displayName"
        },
        "when": {
          "$ref": "#/$defs/cel",
          "description": "Сторож: шаг выполняется, только если истинно"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/cel"
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "as": {
              "$ref": "#/$defs/celMap"
            }
          },
          "description": "Запись результата шага (step.result) в данные экземпляра"
        },
        "export": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "as": {
              "$ref": "#/$defs/celMap"
            }
          }
        },
        "governedBy": {
          "$ref": "#/$defs/governedBy"
        },
        "onCompensate": {
          "$ref": "#/$defs/blocks",
          "description": "Компенсация сделанного шага: выполняется при compensate в обратном порядке"
        },
        "human": {
          "type": "object",
          "required": [
            "taskType",
            "assign"
          ],
          "additionalProperties": false,
          "properties": {
            "taskType": {
              "$ref": "#/$defs/typeKey"
            },
            "title": {
              "$ref": "#/$defs/cel"
            },
            "form": {
              "$ref": "#/$defs/processForm"
            },
            "assign": {
              "$ref": "#/$defs/assignChain"
            },
            "due": {
              "$ref": "#/$defs/durationOrCel"
            },
            "escalations": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "$ref": "#/$defs/escalation"
              }
            },
            "context": {
              "$ref": "#/$defs/stepContext"
            }
          }
        },
        "approve": {
          "type": "object",
          "required": [
            "approvers",
            "quorum"
          ],
          "additionalProperties": false,
          "properties": {
            "taskType": {
              "$ref": "#/$defs/typeKey"
            },
            "approvers": {
              "$ref": "#/$defs/assignChain"
            },
            "mode": {
              "enum": [
                "parallel",
                "sequential"
              ],
              "default": "parallel"
            },
            "quorum": {
              "oneOf": [
                {
                  "enum": [
                    "all",
                    "any"
                  ]
                },
                {
                  "type": "object",
                  "required": [
                    "atLeast"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "atLeast": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 50
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "percent"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "percent": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 100
                    }
                  }
                }
              ]
            },
            "earlyDecision": {
              "type": "boolean",
              "default": true
            },
            "separationOfDuties": {
              "$ref": "#/$defs/cel",
              "description": "CEL → список principal, которым голосовать нельзя; проверяет ядро при решении"
            },
            "due": {
              "$ref": "#/$defs/durationOrCel"
            },
            "onDue": {
              "enum": [
                "approve",
                "reject",
                "escalate"
              ]
            },
            "escalations": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "$ref": "#/$defs/escalation"
              }
            },
            "context": {
              "$ref": "#/$defs/stepContext"
            }
          }
        },
        "call": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "skill"
              ]
            },
            {
              "required": [
                "agent"
              ]
            },
            {
              "required": [
                "process"
              ]
            }
          ],
          "properties": {
            "skill": {
              "type": "string",
              "pattern": "^[^@\\s]+@[^@\\s]+$"
            },
            "agent": {
              "$ref": "#/$defs/slug"
            },
            "process": {
              "$ref": "#/$defs/typeKey"
            },
            "input": {
              "$ref": "#/$defs/celMap"
            },
            "timeout": {
              "$ref": "#/$defs/durationOrCel"
            },
            "context": {
              "$ref": "#/$defs/stepContext"
            }
          }
        },
        "decide": {
          "type": "object",
          "required": [
            "table"
          ],
          "additionalProperties": false,
          "properties": {
            "table": {
              "$ref": "#/$defs/processElementId"
            },
            "input": {
              "$ref": "#/$defs/celMap"
            }
          }
        },
        "recall": {
          "type": "object",
          "required": [
            "anchors"
          ],
          "additionalProperties": false,
          "description": "Запрос к памяти через ядро; ответ — событие журнала (детерминированный replay)",
          "properties": {
            "anchors": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/memoryAnchor"
              }
            },
            "traverse": {
              "$ref": "#/$defs/memoryTraverse"
            },
            "query": {
              "$ref": "#/$defs/cel",
              "description": "Текст смыслового добора"
            },
            "kinds": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "where": {
              "$ref": "#/$defs/memoryWhere"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "timeout": {
              "$ref": "#/$defs/duration"
            },
            "onTimeout": {
              "$ref": "#/$defs/blocks"
            }
          }
        },
        "remember": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "facts"
              ]
            },
            {
              "required": [
                "entity"
              ]
            }
          ],
          "description": "Запись в память наблюдением ядра от identity процесса, со ссылкой на дело",
          "properties": {
            "entity": {
              "type": "object",
              "required": [
                "kind",
                "key"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "key": {
                  "$ref": "#/$defs/cel"
                },
                "name": {
                  "$ref": "#/$defs/cel"
                },
                "text": {
                  "$ref": "#/$defs/cel"
                },
                "links": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "required": [
                      "rel",
                      "kind",
                      "key"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "rel": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      },
                      "kind": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      },
                      "key": {
                        "$ref": "#/$defs/cel"
                      }
                    }
                  }
                }
              }
            },
            "facts": {
              "$ref": "#/$defs/celMap",
              "description": "Имя факта дела → значение"
            }
          }
        },
        "listen": {
          "type": "object",
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "description": "Ожидание первого из событий (отложенный выбор); timeout — таймер",
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "object",
                "required": [
                  "on"
                ],
                "additionalProperties": false,
                "properties": {
                  "on": {
                    "$ref": "#/$defs/processTrigger"
                  },
                  "do": {
                    "$ref": "#/$defs/blocks"
                  }
                }
              }
            },
            "timeout": {
              "$ref": "#/$defs/durationOrCel"
            },
            "onTimeout": {
              "$ref": "#/$defs/blocks"
            }
          }
        },
        "wait": {
          "$ref": "#/$defs/durationOrCel"
        },
        "set": {
          "$ref": "#/$defs/celMap"
        },
        "raise": {
          "$ref": "#/$defs/processError"
        },
        "compensate": {
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/processElementId"
              }
            }
          ],
          "description": "Выполнить onCompensate сделанных шагов в обратном порядке"
        },
        "fork": {
          "type": "object",
          "required": [
            "branches"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "all",
                "compete"
              ],
              "default": "all"
            },
            "branches": {
              "type": "array",
              "minItems": 2,
              "maxItems": 20,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "do"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "$ref": "#/$defs/processElementId"
                  },
                  "do": {
                    "$ref": "#/$defs/blocks"
                  }
                }
              }
            }
          }
        },
        "try": {
          "type": "object",
          "required": [
            "do"
          ],
          "additionalProperties": false,
          "properties": {
            "do": {
              "$ref": "#/$defs/blocks"
            },
            "retry": {
              "type": "object",
              "required": [
                "limit"
              ],
              "additionalProperties": false,
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "delay": {
                  "$ref": "#/$defs/duration"
                },
                "backoff": {
                  "enum": [
                    "constant",
                    "exponential"
                  ]
                },
                "maxDelay": {
                  "$ref": "#/$defs/duration"
                },
                "on": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*$"
                  },
                  "description": "Типы ошибок для повтора; по умолчанию все"
                }
              }
            },
            "catch": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "required": [
                  "do"
                ],
                "additionalProperties": false,
                "properties": {
                  "errors": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "status": {
                        "type": "integer"
                      }
                    }
                  },
                  "as": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9_]*$"
                  },
                  "do": {
                    "$ref": "#/$defs/blocks"
                  }
                }
              }
            }
          }
        },
        "do": {
          "$ref": "#/$defs/blocks"
        },
        "suspend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason": {
              "$ref": "#/$defs/cel"
            }
          }
        },
        "resume": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason": {
              "$ref": "#/$defs/cel"
            }
          }
        },
        "complete": {
          "type": "object",
          "required": [
            "outcome"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        }
      }
    },
    "processTimers": {
      "type": "array",
      "maxItems": 20,
      "description": "Граничные таймеры: срабатывают, пока стадия (процесс) открыта; at от данных пересчитывается при их изменении",
      "items": {
        "type": "object",
        "required": [
          "id",
          "at",
          "do"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/processElementId"
          },
          "at": {
            "$ref": "#/$defs/durationOrCel"
          },
          "interrupting": {
            "type": "boolean",
            "default": false
          },
          "do": {
            "$ref": "#/$defs/blocks"
          }
        }
      }
    },
    "processTrigger": {
      "type": "object",
      "additionalProperties": false,
      "description": "Источник события: событие журнала ядра или наблюдение. where — фильтр CEL над event",
      "oneOf": [
        {
          "required": [
            "event"
          ]
        },
        {
          "required": [
            "observation"
          ]
        }
      ],
      "properties": {
        "event": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "observation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "source": {
          "type": "string",
          "maxLength": 200
        },
        "where": {
          "$ref": "#/$defs/cel"
        }
      }
    },
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "stepContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchors"
      ],
      "description": "Профиль контекста исполнителя шага из памяти (TAI-ADR-0054 Р16): явные связи первыми, смысловой добор с пометкой inferred",
      "properties": {
        "anchors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/memoryAnchor"
          }
        },
        "traverse": {
          "$ref": "#/$defs/memoryTraverse"
        },
        "semantic": {
          "type": "boolean",
          "description": "Добор по смыслу (inferred); по умолчанию true"
        },
        "budgetTokens": {
          "type": "integer",
          "minimum": 200,
          "maximum": 32000
        }
      }
    },
    "typeKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Ключ типа: латиница в нижнем регистре, цифры, _ и -"
    }
  }
}
